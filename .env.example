# Copy to .env and fill in. Defaults below match docker-compose.yml.

# Postgres 16. Local: `docker compose up -d`. Production: Neon.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/dev_job_board

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend. Transactional email only; send failures never block a write.
# Leave RESEND_API_KEY blank for local development — emails are logged to the
# console instead of sent, so nothing here is required to run the app.
RESEND_API_KEY=

# Sender address. Optional: defaults to Resend's shared testing sender, which
# works without verifying a domain. Point it at your own domain in production.
EMAIL_FROM=Dev Job Board <onboarding@resend.dev>
